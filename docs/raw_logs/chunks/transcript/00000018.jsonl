] = useState<number>(0);\\n  const [firedCount, setFiredCount] = useState<number>(0);\\n\\n  const [traders, setTraders] = useState<Trader[]>(INITIAL_TRADERS);\\n  const [activeTraderId, setActiveTraderId] = useState<string>('trader_1');\\n\\n  // Self-Evolving Engine State\\n  const [evolution, setEvolution] = useState<EvolutionState>(() => loadStoredEvolution());\\n\\n  // Pending Human-In-The-Loop Order\\n  const [pendingOrder, setPendingOrder] = useState<PendingOrder | null>(null);\\n\\n  // 7-Agent Committee State\\n  const [committee, setCommittee] = useState<HermesCommittee>({\\n    atlas: {\\n      bias: 'BULLISH',\\n      macroSummary: 'Higher-timeframe 4H market structure holds above 20,380 support. S&P/Nasdaq divergen\n<truncated 17476 bytes>","Description":"\"Upgrade useTradingSimulation.ts with 7-Agent Committee, Self-Evolving Engine, Prop Firm Mode, and HITL execution\"","Overwrite":"true","TargetFile":"\"/Users/dev/Documents/Antigravity/grok-bot-dashboard/src/engine/useTradingSimulation.ts\"","toolAction":"\"Updating useTradingSimulation.ts\"","toolSummary":"\"Update simulation hook\""}}],"truncated_fields":["tool_calls"]}
