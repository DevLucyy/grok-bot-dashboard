t,\\n    pnlMultiplier,\\n    tradesCopied,\\n    lossesInARow,\\n    firedCount,\\n    traders,\\n    activeTrader,\\n    activeTraderId,\\n    committee,\\n    evolution,\\n    currentThought,\\n    selectTrader,\\n    resetSimulation,\\n    logs,\\n    chartHistory,\\n    marketCategory\\n  } = useTradingSimulation();\\n\\n  return (\\n    <div className=\\\"min-h-screen p-3 md:p-6 max-w-7xl mx-auto flex flex-col gap-5\\\">\\n      {/* 1. Header with clean branding, autopilot badge, speed multipliers, and pause/reset */}\\n      <Header\\n        tradesCopied={tradesCopied}\\n        isRunning={isRunning}\\n        setIsRunning={setIsRunning}\\n        speed={speed}\\n        setSpeed={setSpeed}\\n        onReset={resetSimulation}\\n      />\\n\\n      {/* 2. Unified Mastermind Beast Core (Pulsing Brain, Level Progression, 7 Internal Cognitive Lobes, Neural Thought Stream) */}\\n      <MastermindCore\\n        evolution={evolution}\\n        committee={committee}\\n        currentThought={currentThought}\\n      />\\n\\n      {/* 3. Top Metric Cards (Balance, P&L, Operator with Win/Loss Glow Pills, 2-Strike Handbrake) */}\\n      <BalanceCards\\n        balance={balance}\\n        startingBalance={startingBalance}\\n        totalPnl={totalPnl}\\n        pnlPercent={pnlPercent}\\n        pnlMultiplier={pnlMultiplier}\\n        activeTrader={activeTrader}\\n        lossesInARow={lossesInARow}\\n        firedCount={firedCount}\\n        onManualFire={() => {}}\\n \n<truncated 1446 bytes>","Description":"\"Refactor App.tsx to unify entire dashboard under the MastermindCore beast without clutter\"","Overwrite":"true","TargetFile":"\"/Users/dev/Documents/Antigravity/grok-bot-dashboard/src/App.tsx\"","toolAction":"\"Updating App.tsx layout\"","toolSummary":"\"Refactor App.tsx\""}}],"truncated_fields":["tool_calls"]}
