{"step_index":1384,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-19T18:44:47Z","content":"Created At: 2026-10-20T00:14:47+05:30\nCompleted At: 2026-10-20T00:14:48+05:30\nFile Path: `file:///Users/dev/Documents/Antigravity/grok-bot-dashboard/src/engine/evolutionEngine.ts`\nTotal Lines: 158\nTotal Bytes: 5463\nShowing lines 1 to 115\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import { EvolutionState, AdaptiveWeights, EvolutionEvent } from '../types';\n2: \n3: export const LEVEL_TIERS: { level: number; title: string; minXp: number; maxXp: number; perk: string }[] = [\n4:   { level: 1, title: 'Novice Algorithmic Desk', minXp: 0, maxXp: 150, perk: 'Basic regime detection' },\n5:   { level: 2, title: 'Pattern Recognition Engine', minXp: 150, maxXp: 350, perk: '+5% False Breakout Veto' },\n6:   { level: 3, title: 'Microstructure Analyst', minXp: 350, maxXp: 650, perk: '+8% Order Book Calibration' },\n7:   { level: 4, title: 'Adaptive Regime Specialist', minXp: 650, maxXp: 1100, perk: '+12% Dynamic Kelly Precision' },\n8:   { level: 5, title: 'Asymmetric Risk Architect', minXp: 1100, maxXp: 1750, perk: '+15% Drawdown Shielding' },\n9:   { level: 6, title: 'High-Convexity Quant', minXp: 1750, maxXp: 2600, perk: '+18% Regime Matching Accuracy' },\n10:   { level: 7, title: 'Bayesian Inference Engine', minXp: 2600, maxXp: 3700, perk: '+22% Noise Filtering' },\n11:   { level: 8, title: 'Alpha Protocol Desk', minXp: 3700, maxXp: 5200, perk: '+26% Asymmetric Payoff Targeting' },\n12:   { level: 9, title: 'Autonomous Capital Master', minXp: 5200, maxXp: 7200, perk: '+30% Multi-Timeframe Synthesis' },\n13:   { level: 10, title: 'Quantitative Grandmaster', minXp: 7200, maxXp: 99999, perk: 'Maximum Wisdom & Sovereign Execution' }\n14: ];\n15: \n16: export const INITIAL_EVOLUTION: EvolutionState = {\n17:   level: 1,\n18:   title: 'Novice Algorithmic Desk',\n19:   xp: 0,\n20:   nextLevelXp: 150,\n21:   winStreak: 0,\n22:   totalTrades: 0,\n23:   total\n<truncated 976 bytes>\nddExperience(\n63:   current: EvolutionState,\n64:   amount: number,\n65:   reason: string,\n66:   type: 'XP' | 'LEVEL_UP' | 'WEIGHT_UPDATE' = 'XP'\n67: ): EvolutionState {\n68:   const newXp = current.xp + amount;\n69:   \n70:   // Find matching level\n71:   let matchedTier = LEVEL_TIERS[0];\n72:   for (const tier of LEVEL_TIERS) {\n73:     if (newXp >= tier.minXp) {\n74:       matchedTier = tier;\n75:     }\n76:   }\n77: \n78:   const isLevelUp = matchedTier.level > current.level;\n79:   const timeStr = new Date().toTimeString().split(' ')[0];\n80: \n81:   const newEvents: EvolutionEvent[] = [\n82:     {\n83:       id: `evo_${Date.now()}_${Math.random()}`,\n84:       timestamp: timeStr,\n85:       text: isLevelUp ? `⚡ LEVEL UP! Ascended to Level ${matchedTier.level}: ${matchedTier.title}! (${matchedTier.perk})` : `+${amount} XP: ${reason}`,\n86:       type: isLevelUp ? 'LEVEL_UP' : type\n87:     },\n88:     ...current.recentEvolutions.slice(0, 15)\n89:   ];\n90: \n91:   // If leveled up, boost adaptive weights\n92:   let updatedWeights = { ...current.adaptiveWeights };\n93:   if (isLevelUp) {\n94:     updatedWeights = {\n95:       regimePrecision: Number((updatedWeights.regimePrecision + 2.5).toFixed(1)),\n96:       falseBreakoutFilter: Number((updatedWeights.falseBreakoutFilter + 3.0).toFixed(1)),\n97:       sentimentCalibration: Number((updatedWeights.sentimentCalibration + 2.0).toFixed(1)),\n98:       dynamicSizingEdge: Number((updatedWeights.dynamicSizingEdge + 2.5).toFixed(1))\n99:     };\n100:   }\n101: \n102:   const updated: EvolutionState = {\n103:     ...current,\n104:     level: matchedTier.level,\n105:     title: matchedTier.title,\n106:     xp: newXp,\n107:     nextLevelXp: matchedTier.maxXp,\n108:     adaptiveWeights: updatedWeights,\n109:     recentEvolutions: newEvents\n110:   };\n111: \n112:   saveStoredEvolution(updated);\n113:   return updated;\n114: }\n115: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n","truncated_fields":["content"]}
