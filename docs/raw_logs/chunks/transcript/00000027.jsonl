{"step_index":1523,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-19T19:03:40Z","content":"Created At: 2026-10-20T00:33:40+05:30\nCompleted At: 2026-10-20T00:33:41+05:30\nFile Path: `file:///Users/dev/Documents/Antigravity/grok-bot-dashboard/src/engine/useTradingSimulation.ts`\nTotal Lines: 588\nTotal Bytes: 19829\nShowing lines 150 to 210\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n150: \n151:   // Handle market switch\n152:   const switchMarket = (targetMarket: MarketCategory) => {\n153:     setMarketCategory(targetMarket);\n154:     const newStart = targetMarket === 'PROP_FIRM' ? PROP_FIRM_STARTING_BALANCE : CRYPTO_STARTING_BALANCE;\n155:     setBalance(newStart);\n156:     peakBalanceRef.current = newStart;\n157:     setTradesCopied(0);\n158:     setLossesInARow(0);\n159:     setPendingOrder(null);\n160:     setChartHistory([\n161:       {\n162:         timeIndex: 0,\n163:         timeLabel: new Date().toTimeString().split(' ')[0],\n164:         balance: newStart,\n165:         traderHandle: activeTrader.handle,\n166:         traderColor: '#f59e0b'\n167:       }\n168:     ]);\n169:     setLogs(prev => [\n170:       {\n171:         id: `mkt_${Date.now()}`,\n172:         timestamp: new Date().toTimeString().split(' ')[0],\n173:         type: 'SYSTEM',\n174:         message: targetMarket === 'PROP_FIRM'\n175:           ? 'Switched to Topstep $50K Futures Mode (NQ, ES, GC, CL). Target: $53,000 | Trailing Stop: $48,000.'\n176:           : 'Switched to Crypto Mode ($42 -> Compounding Spot & Perps).'\n177:       },\n178:       ...prev\n179:     ]);\n180:   };\n181: \n182:   // Execute trade after approval or automatic dispatch\n183:   const executeTrade = useCallback((order: PendingOrder, isWin: boolean) => {\n184:     const timeStr = new Date().toTimeString().split(' ')[0];\n185:     \n186:     // Calculate P&L based on market\n187:     let pnlAmt = 0;\n188:     if (marketCategory === 'PROP_FIRM') {\n189:       pnlAmt = isWin ? Number((order.riskUsd * (order.targetPrice - order.entryPrice) / (order.entryPrice - order.stopLoss)).toFixed(2))\n190:                      : -order.riskUsd;\n191:     } else {\n192:       // Crypto scaling\n193:       if (balance < 100) {\n194:         pnlAmt = isWin ? Number((Math.random() * 4 + 1.5).toFixed(2)) : -Number((Math.random() * 0.9 + 0.3).toFixed(2));\n195:       } else if (balance < 500) {\n196:         pnlAmt = isWin ? Number((Math.random() * 25 + 9).toFixed(2)) : -Number((Math.random() * 6 + 1.8).toFixed(2));\n197:       } else if (balance < 2000) {\n198:         pnlAmt = isWin ? Number((Math.random() * 140 + 48).toFixed(2)) : -Number((Math.random() * 32 + 9).toFixed(2));\n199:       } else {\n200:         pnlAmt = isWin ? Number((Math.random() * 650 + 190).toFixed(2)) : -Number((Math.random() * 75 + 18).toFixed(2));\n201:       }\n202:     }\n203: \n204:     const newBalance = Number((balance + pnlAmt).toFixed(2));\n205: \n206:     if (newBalance > peakBalanceRef.current) {\n207:       peakBalanceRef.current = newBalance;\n208:     }\n209: \n210:     // Topstep $50k trailing drawdown check\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
