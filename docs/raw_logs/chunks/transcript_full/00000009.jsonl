   handle: '@tenbag_ted',\n    name: 'Tenbag Ted',\n    initials: 'TT',\n    avatarColor: 'from-indigo-500 to-violet-600',\n    rank: 5,\n    weeklyRank: '#5 weekly',\n    sevenDayReturn: 198,\n    winRate: 64,\n    copyRatio: 0.25,\n    status: 'BENCH',\n    pnlWithUs: 0,\n    lastSix: ['W', 'L', 'W', 'W', 'W', 'W']\n  },\n  {\n    id: 'trader_6',\n    handle: '@rugless_rio',\n    name: 'Rugless Rio',\n    initials: 'RR',\n    avatarColor: 'from-teal-400 to-cyan-600',\n    rank: 6,\n    weeklyRank: '#6 weekly',\n    sevenDayReturn: 167,\n    winRate: 70,\n    copyRatio: 0.25,\n    status: 'BENCH',\n    pnlWithUs: 0,\n    lastSix: ['W', 'W', 'W', 'W', 'L', 'W']\n  }\n];\n\nexport const TOKEN_LIST = [\n  '$SNEK', '$ZOOM', '$FLUFF', '$MOCHA', '$BLAST', '$TOAD', '$NYAN2', '$CHIRP', '$PEPE', '$WIF', '$BONK', '$POPCAT'\n];\n\nexport const INITIAL_STARTING_BALANCE = 42.00;\n","Description":"Initial mock traders and tokens matching Grok Bot video 1","Overwrite":true,"TargetFile":"/Users/dev/Documents/Antigravity/grok-bot-dashboard/src/engine/simulationData.ts","toolAction":"Writing simulationData.ts","toolSummary":"Create initial simulation data"}}]}
