iv className=\"flex items-center gap-0.5 text-amber-400\">\n              <span className=\"w-1 h-2 bg-amber-400 rounded-full inline-block animate-pulse\"></span>\n              <span className=\"w-1 h-3.5 bg-amber-400 rounded-full inline-block\"></span>\n              <span className=\"w-1 h-1.5 bg-amber-400 rounded-full inline-block\"></span>\n            </div>\n          </div>\n          <p className=\"text-[11px] font-semibold tracking-wider text-slate-400 font-mono-numbers uppercase\">\n            {mode === 'COPY_TRADING' ? 'COPY TRADING MODE' : 'QUANT REGIME ENGINE MODE'}\n          </p>\n        </div>\n      </div>\n\n      {/* Middle: Mode Switch & Simulation Controls */}\n      <div className=\"flex flex-wrap items-center gap-2\">\n        {/* Mode Switcher */}\n        <div className=\"bg-[#0b1022] p-1 rounded-xl border border-[#212b48] flex items-center gap-1\">\n          <button\n            onClick={() => setMode('COPY_TRADING')}\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all ${\n              mode === 'COPY_TRADING'\n                ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white shadow-md shadow-blue-500/20'\n                : 'text-slate-400 hover:text-slate-200'\n            }`}\n          >\n            <Zap className=\"w-3.5 h-3.5 text-amber-300\" />\n            Copy Trading\n          </button>\n          <button\n            onClick={() => setMode('QUANT_REGIME')}\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all ${\n              mode === 'QUANT_REGIME'\n                ? 'bg-gradient-to-r from-indigo-600 to-purple-600 text-white shadow-md shadow-indigo-500/20'\n                : 'text-slate-400 hover:text-slate-200'\n            }`}\n          >\n            <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-400\" />\n            Quant Engine\n          </button>\n        </div>\n\n        {/* Speed & Playback */}\n        <div className=\"bg-[#0b1022] p-1 rounded-xl border border-[#212b48] flex items-center gap-1\">\n          <button\n            onClick={() => setIsRunning(!isRunning)}\n            className={`p-1.5 rounded-lg transition-colors ${\n              isRunning ? 'bg-amber-500/20 text-amber-300 hover:bg-amber-500/30' : 'bg-emerald-500/20 text-emerald-400 hover:bg-emerald-500/30'\n            }`}\n            title={isRunning ? 'Pause Simulation' : 'Resume Simulation'}\n          >\n            {isRunning ? <Pause className=\"w-3.5 h-3.5\" /> : <Play className=\"w-3.5 h-3.5\" />}\n          </button>\n\n          <button\n            onClick={onReset}\n            className=\"p-1.5 rounded-lg text-slate-400 hover:text-slate-200 hover:bg-slate-800 transition-colors\"\n            title=\"Reset Simulation\"\n          >\n            <RotateCcw className=\"w-3.5 h-3.5\" />\n          </button>\n\n          <div className=\"h-4 w-px bg-slate-800 mx-0.5\"></div>\n\n          {[1, 2, 5, 10].map(s => (\n            <button\n              key={s}\n              onClick={() => setSpeed(s)}\n              className={`px-2 py-1 text-[11px] font-mono-numbers rounded font-medium transition-all ${\n                speed === s\n                  ? 'bg-blue-600/40 text-blue-300 border border-blue-500/30'\n                  : 'text-slate-500 hover:text-slate-300'\n              }`}\n            >\n              {s}x\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Right: Stats & Brand Badge */}\n      <div className=\"flex items-center gap-3\">\n        <div className=\"hidden sm:block text-right\">\n          <span className=\"text-[11px] font-mono-numbers text-slate-400 uppercase tracking-wider block\">\n            {tradesCopied} Trades Copied\n          </span>\n        </div>\n\n        {/* CopyFOMO Brand Pill */}\n        <div className=\"flex items-center gap-2 px-3 py-1.5 rounded-xl bg-[#0e1428] border border-[#232e50] shadow-sm\">\n          <div className=\"w-6 h-6 rounded-lg bg-blue-600 flex items-center justify-center font-bold text-white text-[10px]\">\n            ∞\n          </div>\n          <div className=\"text-left\">\n            <span className=\"text-xs font-bold text-slate-100 block leading-none\">copyfomo</span>\n            <span className=\"text-[9px] text-slate-400 tracking-tight block uppercase leading-tight font-mono-numbers\">\n              Copy Trading on FOMO\n            </span>\n          </div>\n        </div>\n\n        {/* LIVE Indicator */}\n        <div className=\"flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20\">\n          <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-ping\"></span>\n          <span className=\"text-[10px] font-bold text-emerald-400 uppercase tracking-wider\">LIVE</span>\n        </div>\n      </div>\n    </header>\n  );\n};\n","Description":"Writing Header.tsx with typed props","Overwrite":true,"TargetFile":"/Users/dev/Documents/Antigravity/grok-bot-dashboard/src/components/Header.tsx","toolAction":"Updating Header.tsx","toolSummary":"Fix Header.tsx props typing"}}]}
