87: \n88:       return finalTraders;\n89:     });\n90: \n91:     const firedTrader = traders.find(t => t.id === activeTraderId);\n92:     const timeStr = new Date().toTimeString().split(' ')[0];\n93: \n94:     // Log the fire event\n95:     setLogs(prev => [\n96:       {\n97:         id: `fire_${Date.now()}`,\n98:         timestamp: timeStr,\n99:         type: 'FIRE',\n100:         traderHandle: firedTrader?.handle,\n101:         message: `${firedTrader?.handle}: ${reason}`\n102:       },\n103:       ...prev\n104:     ]);\n105: \n106:     setLossesInARow(0);\n107:     setFiredCount(c => c + 1);\n108: \n109:     // Pick next trader\n110:     setTimeout(() => {\n111:       setTraders(latestTraders => {\n112:         const nextTrader = latestTraders.find(t => t.status === 'FOLLOWING');\n113:         if (nextTrader) {\n114:           setActiveTraderId(nextTrader.id);\n115:           setLogs(prev => [\n116:             {\n117:               id: `pick_${Date.now()}`,\n118:               timestamp: new Date().toTimeString().split(' ')[0],\n119:               type: 'PICK',\n120:               traderHandle: nextTrader.handle,\n121:               message: `${nextTrader.handle} ${nextTrader.weeklyRank} · ${nextTrader.winRate}% WR -> follow`\n122:             },\n123:             ...prev\n124:           ]);\n125: \n126:           // Add handover flag on chart\n127:           setChartHistory(prev => [\n128:             ...prev,\n129:             {\n130:               timeIndex: prev.length,\n131:               timeLabel: new Date().toTimeString().split(' ')[0],\n132:               balance: prev[prev.length - 1].balance,\n133:               traderHandle: nextTrader.handle,\n134:               traderColor: nextTrader.avatarColor.includes('amber') ? '#f59e0b' :\n135:                            nextTrader.avatarColor.includes('sky') ? '#38bdf8' :\n136:                            nextTrader.avatarColor.includes('emerald') ? '#22c55e' : '#a855f7',\n137:               isHandoverPoint: true\n138:             }\n139:           ]);\n140:         }\n141:         return latestTraders;\n142:       });\n143:     }, 400);\n144: \n145:   }, [activeTraderId, traders]);\n146: \n147:   // Main simulation tick\n148:   useEffect(() => {\n149:     if (!isRunning) return;\n150: \n151:     const intervalTime = Math.max(300, 2000 / speed);\n152: \n153:     const interval = setInterval(() => {\n154:       tickCountRef.current += 1;\n155:       const timeStr = new Date().toTimeString().split(' ')[0];\n156: \n157:       // Pick token\n158:       const token = TOKEN_LIST[Math.floor(Math.random() * TOKEN_LIST.length)];\n159: \n160:       // Determine outcome probability based on active trader winRate\n161:       const isWin = (Math.random() * 100) < (activeTrader.winRate);\n162: \n163:       // Sizing & PnL simulation matching the dramatic curve\n164:       let delta = 0;\n165:       if (balance < 100) {\n166:         delta = isWin ? (Math.random() * 4 + 1.2) : -(Math.random() * 0.8 + 0.3);\n167:       } else if (balance < 500) {\n168:         delta = isWin ? (Math.random() * 25 + 8) : -(Math.random() * 6 + 1.5);\n169:       } else if (balance < 2000) {\n170:         delta = isWin ? (Math.random() * 140 + 45) : -(Math.random() * 30 + 8);\n171:       } else {\n172:         delta = isWin ? (Math.random() * 650 + 180) : -(Math.random() * 75 + 15);\n173:       }\n174: \n175:       const newBalance = Math.max(10, Number((balance + delta).toFixed(2)));\n176:       const pnlAmt = Number(delta.toFixed(2));\n177: \n178:       // Update peak balance & drawdown\n179:       if (newBalance > peakBalanceRef.current) {\n180:         peakBalanceRef.current = newBalance;\n181:       }\n182:       const currentDrawdown = Number((((peakBalanceRef.current - newBalance) / peakBalanceRef.current) * 100).toFixed(1));\n183: \n184:       // Circuit breaker check (15% drawdown)\n185:       if (currentDrawdown >= 15.0 && quantState.armedKillSwitch) {\n186:         setLogs(prev => [\n187:           {\n188:             id: `kill_${Date.now()}`,\n189:             timestamp: timeStr,\n190:             type: 'QUANT',\n191:             message: `🚨 HARD KILL-SWITCH TRIGGERED: 15% Max Drawdown breached (${currentDrawdown}%). Trading halted.`\n192:           },\n193:           ...prev\n194:         ]);\n195:         setIsRunning(false);\n196:         return;\n197:       }\n198: \n199:       setBalance(newBalance);\n200:       setTradesCopied(c => c + 1);\n201: \n202:       // Update trader P&L and lastSix\n203:       setTraders(prev => prev.map(t => {\n204:         if (t.id === activeTraderId) {\n205:           const updatedLastSix = [...t.lastSix.slice(1), isWin ? 'W' as const : 'L' as const];\n206:           return {\n207:             ...t,\n208:             pnlWithUs: Number((t.pnlWithUs + pnlAmt).toFixed(2)),\n209:             lastSix: updatedLastSix\n210:           };\n211:         }\n212:         return t;\n213:       }));\n214: \n215:       // Chart stepped point\n216:       setChartHistory(prev => [\n217:         ...prev,\n218:         {\n219:           timeIndex: prev.length,\n220:           timeLabel: timeStr,\n221:           balance: newBalance,\n222:           traderHandle: activeTrader.handle,\n223:           traderColor: activeTrader.avatarColor.includes('amber') ? '#f59e0b' :\n224:                        activeTrader.avatarColor.includes('sky') ? '#38bdf8' :\n225:                        activeTrader.avatarColor.includes('emerald') ? '#22c55e' : '#a855f7'\n226:         }\n227:       ]);\n228: \n229:       // Copy & Exit logs\n230:       const copyLog: TradeLog = {\n231:         id: `copy_${Date.now()}_1`,\n232:         timestamp: timeStr,\n233:         type: 'COPY',\n234:         traderHandle: activeTrader.handle,\n235:         token,\n236:         copyRatio: '0.25x',\n237:         message: `[COPY] ${activeTrader.handle} bought ${token} · copy 0.25x`\n238:       };\n239: \n240:       const exitLog: TradeLog = {\n241:         id: `exit_${Date.now()}_2`,\n242:         timestamp: timeStr,\n243:         type: 'EXIT',\n244:         traderHandle: activeTrader.handle,\n245:         token,\n246:         pnlUsd: pnlAmt,\n247:         isLoss: !isWin,\n248:         message: `[EXIT] ${activeTrader.handle} sold ${token} · we exit  ${isWin ? '+' : ''}$${pnlAmt}`\n249:       };\n250: \n251:       setLogs(prev => [exitLog, copyLog, ...prev.slice(0, 40)]);\n252: \n253:       // Check 2 losses in a row rule\n254:       if (!isWin) {\n255:         const nextLossCount = lossesInARow + 1;\n256:         setLossesInARow(nextLossCount);\n257:         if (nextLossCount >= 2) {\n258:           fireCurrentTrader();\n259:         }\n260:       } else {\n261:         setLossesInARow(0);\n262:       }\n263: \n264:       // Update Quant metrics simulation\n265:       setQuantState(prev => {\n266:         const midJitter = (Math.random() - 0.48) * 45;\n267:         const newMid = Number((prev.midPrice + midJitter).toFixed(2));\n268:         const newImbalance = Number(((Math.random() * 1.6) - 0.8).toFixed(2));\n269:         const newVol = Number((16 + Math.random() * 8).toFixed(1));\n270:         const newLatency = Math.floor(75 + Math.random() * 15);\n271: \n272:         let newRegime = prev.regime;\n273:         if (newVol > 22) newRegime = 'HIGH_VOL';\n274:         else if (Math.abs(newImbalance) > 0.5) newRegime = 'TRENDING';\n275:         else newRegime = 'MEAN_REVERTING';\n276: \n277:         return {\n278:           ...prev,\n279:           midPrice: newMid,\n280:           orderBookImbalance: newImbalance,\n281:           realizedVolatility: newVol,\n282:           currentDrawdown,\n283:           reflexLatencyMs: newLatency,\n284:           regime: newRegime\n285:         };\n286:       });\n287: \n288:     }, intervalTime);\n289: \n290:     return () => clearInterval(interval);\n291:   }, [isRunning, speed, balance, activeTrader, activeTraderId, lossesInARow, fireCurrentTrader, quantState.armedKillSwitch]);\n292: \n293:   // Reset function\n294:   const resetSimulation = () => {\n295:     setBalance(INITIAL_STARTING_BALANCE);\n296:     peakBalanceRef.current = INITIAL_STARTING_BALANCE;\n297:     setTradesCopied(0);\n298:     setLossesInARow(0);\n299:     setFiredCount(0);\n300:     setTraders(INITIAL_TRADERS);\n301:     setActiveTraderId('trader_1');\n302:     setLogs([\n303:       {\n304:         id: `init_${Date.now()}`,\n305:         timestamp: new Date().toTimeString().split(' ')[0],\n306:         type: 'SCAN',\n307:         message: 'weekly top on FOMO loaded · 6 traders'\n308:       }\n309:     ]);\n310:     setChartHistory([\n311:       {\n312:         timeIndex: 0,\n313:         timeLabel: '00:00:00',\n314:         balance: 42.00,\n315:         traderHandle: '@kai_blitz',\n316:         traderColor: '#f59e0b'\n317:       }\n318:     ]);\n319:     setIsRunning(true);\n320:   };\n321: \n322:   const totalPnl = Number((balance - startingBalance).toFixed(2));\n323:   const pnlPercent = Number(((totalPnl / startingBalance) * 100).toFixed(1));\n324:   const pnlMultiplier = Number((balance / startingBalance).toFixed(1));\n325: \n326:   const selectTrader = (id: string) => {\n327:     setTraders(prev => prev.map(t => ({\n328:       ...t,\n329:       status: t.id === id ? 'FOLLOWING' : (t.status === 'FOLLOWING' ? 'BENCH' : t.status)\n330:     })));\n331:     setActiveTraderId(id);\n332:     const chosen = traders.find(t => t.id === id);\n333:     if (chosen) {\n334:       setLogs(prev => [\n335:         {\n336:           id: `pick_${Date.now()}`,\n337:           timestamp: new Date().toTimeString().split(' ')[0],\n338:           type: 'PICK',\n339:           traderHandle: chosen.handle,\n340:           message: `Manual select: ${chosen.handle} ${chosen.weeklyRank} · ${chosen.winRate}% WR -> follow`\n341:         },\n342:         ...prev\n343:       ]);\n344:     }\n345:   };\n346: \n347:   return {\n348:     mode,\n349:     setMode,\n350:     isRunning,\n351:     setIsRunning,\n352:     speed,\n353:     setSpeed,\n354:     balance,\n355:     startingBalance,\n356:     totalPnl,\n357:     pnlPercent,\n358:     pnlMultiplier,\n359:     tradesCopied,\n360:     lossesInARow,\n361:     firedCount,\n362:     traders,\n363:     activeTrader,\n364:     activeTraderId,\n365:     setActiveTraderId,\n366:     selectTrader,\n367:     fireCurrentTrader,\n368:     logs,\n369:     chartHistory,\n370:     quantState,\n371:     resetSimulation\n372:   };\n373: }\n374: \nThe above content shows the entire, complete file contents of the requested file.\n"}
