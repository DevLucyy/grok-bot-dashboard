    setSpeed={setSpeed}\n48:         onReset={resetSimulation}\n49:       />\n50: \n51:       {/* 2. Top Metric Cards */}\n52:       <BalanceCards\n53:         balance={balance}\n54:         startingBalance={startingBalance}\n55:         totalPnl={totalPnl}\n56:         pnlPercent={pnlPercent}\n57:         pnlMultiplier={pnlMultiplier}\n58:         activeTrader={activeTrader}\n59:         lossesInARow={lossesInARow}\n60:         firedCount={firedCount}\n61:         onManualFire={() => fireCurrentTrader('Manual operator override -> fired')}\n62:       />\n63: \n64:       {/* 3. Conditional Quant Regime Panel (Leaked Prompt Integration) */}\n65:       {mode === 'QUANT_REGIME' && (\n66:         <QuantRegimePanel quantState={quantState} />\n67:       )}\n68: \n69:       {/* 4. Middle Section: Stepped Chart & Copy Feed */}\n70:       <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-5\">\n71:         {/* Left: Balance History Chart (7 Cols) */}\n72:         <div className=\"lg:col-span-7\">\n73:           <SteppedChart\n74:             history={chartHistory}\n75:             currentBalance={balance}\n76:           />\n77:         </div>\n78: \n79:         {/* Right: Live Copy Feed (5 Cols) */}\n80:         <div className=\"lg:col-span-5\">\n81:           <CopyFeed logs={logs} />\n82:         </div>\n83:       </div>\n84: \n85:       {/* 5. Bottom: Trader Bench Roster */}\n86:       <TraderBench\n87:         traders={traders}\n88:         activeTraderId={activeTraderId}\n89:         onSelectTrader={selectTrader}\n90:       />\n91: \n92:       {/* 6. Footer Disclaimer & AppSec Safety Notice */}\n93:       <footer className=\"mt-2 pt-3 border-t border-[#1a233d]/60 flex flex-col sm:flex-row items-center justify-between text-[11px] text-slate-500 font-mono-numbers gap-2\">\n94:         <div className=\"flex items-center gap-1.5 text-slate-400\">\n95:           <Shield className=\"w-3.5 h-3.5 text-emerald-400\" />\n96:           <span>Deterministic Simulation Environment · Zero-Key Sandboxing · 15% Max Drawdown Circuit Breaker</span>\n97:         </div>\n98:         <div>\n99:           <span>Grok Bot v2.4 · Copy Trading &amp; Quant Engine</span>\n100:         </div>\n101:       </footer>\n102:     </div>\n103:   );\n104: }\n105: \n106: export default App;\n107: \nThe above content shows the entire, complete file contents of the requested file.\n"}
