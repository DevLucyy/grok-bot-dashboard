{"step_index":1069,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-19T17:50:40Z","content":"Created At: 2026-10-19T23:20:40+05:30\nCompleted At: 2026-10-19T23:20:41+05:30\nFile Path: `file:///Users/dev/Documents/Antigravity/grok-bot-dashboard/src/components/BalanceCards.tsx`\nTotal Lines: 196\nTotal Bytes: 8491\nShowing lines 1 to 196\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import { ArrowUpRight, Flame, UserCheck } from 'lucide-react';\n2: import { Trader } from '../types';\n3: \n4: interface BalanceCardsProps {\n5:   balance: number;\n6:   startingBalance: number;\n7:   totalPnl: number;\n8:   pnlPercent: number;\n9:   pnlMultiplier: number;\n10:   activeTrader: Trader;\n11:   lossesInARow: number;\n12:   firedCount: number;\n13:   onManualFire: () => void;\n14: }\n15: \n16: export const BalanceCards = ({\n17:   balance,\n18:   startingBalance,\n19:   totalPnl,\n20:   pnlPercent,\n21:   pnlMultiplier,\n22:   activeTrader,\n23:   lossesInARow,\n24:   firedCount,\n25:   onManualFire\n26: }: BalanceCardsProps) => {\n27:   return (\n28:     <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n29:       {/* 1. BALANCE CARD */}\n30:       <div className=\"cyber-card p-4 rounded-2xl flex flex-col justify-between\">\n31:         <div className=\"text-[11px] font-mono-numbers text-slate-400 font-semibold tracking-wider uppercase\">\n32:           Balance\n33:         </div>\n34:         <div className=\"my-2\">\n35:           <div className=\"text-3xl font-extrabold text-white font-mono-numbers tracking-tight\">\n36:             ${balance.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}\n37:           </div>\n38:           <div className=\"text-[11px] text-slate-500 font-mono-numbers mt-1\">\n39:             started at ${startingBalance.toFixed(2)}\n40:           </div>\n41:         </div>\n42:         <div className=\"h-1 w-full bg-slate-800 rounded-full overflow-hidden\">\n43:           <div\n44:             className=\"h-full bg-gradient-to-r from-blue-500 to-emerald-400 transition-all duration-300\"\n45:             style={{ width: `${Math.min(100, (balance / 5739) * 100)}%` }}\n46:           ></div>\n47:         </div>\n48:       </div>\n49: \n50:       {/* 2. TOTAL P&L CARD */}\n51:       <div className=\"cyber-card p-4 rounded-2xl flex flex-col justify-between\">\n52:         <div className=\"flex items-center justify-between text-[11px] font-mono-numbers text-slate-400 font-semibold tracking-wider uppercase\">\n53:           <span>Total P&L</span>\n54:           <ArrowUpRight className=\"w-3.5 h-3.5 text-emerald-400\" />\n55:         </div>\n56:         <div className=\"my-2\">\n57:           <div className=\"text-3xl font-extrabold text-emerald-400 font-mono-numbers tracking-tight flex items-center gap-1 drop-shadow-[0_0_12px_rgba(34,197,94,0.35)]\">\n58:             +${totalPnl.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}\n59:           </div>\n60:           <div className=\"flex items-center gap-2 mt-1\">\n61:             <span className=\"text-[11px] font-bold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full font-mono-numbers border border-emerald-500/20\">\n62:               +{pnlPercent.toLocaleString()}%\n63:             </span>\n64:             <span className=\"text-[11px] font-medium text-slate-400 font-mono-numbers\">\n65:               x{pnlMultiplier.toFixed(1)}\n66:             </span>\n67:           </div>\n68:         </div>\n69:         <div className=\"text-[10px] text-slate-500 font-mono-numbers flex justify-between\">\n70:           <span>Net Profit</span>\n71:           <span className=\"text-emerald-400 font-semibold\">100% Compounding</span>\n72:         </div>\n73:       </div>\n74: \n75:       {/* 3. NOW COPYING CARD */}\n76:       <div className=\"cyber-card p-4 rounded-2xl flex flex-col justify-between\">\n77:         <div className=\"flex items-center justify-between\">\n78:           <div className=\"text-[11px] font-mono-numbers text-slate-400 font-semibold tracking-wider uppercase flex items-center gap-1.5\">\n79:             <UserCheck className=\"w-3.5 h-3.5 text-blue-400\" />\n80:             Now Copying\n81:           </div>\n82:           <span className=\"text-[10px] font-mono-numbers text-slate-400 font-semibold uppercase\">\n83:             Last 6\n84:           </span>\n85:         </div>\n86: \n87:         <div className=\"my-2 flex items-center justify-between gap-2\">\n88:           {/* Avatar and handle */}\n89:           <div className=\"flex items-center gap-2.5\">\n90:             <div className={`w-10 h-10 rounded-full bg-gradient-to-br ${activeTrader.avatarColor} flex items-center justify-center font-bold text-white text-xs shadow-md border border-white/10 shrink-0 font-display`}>\n91:               {activeTrader.initials}\n92:             </div>\n93:             <div>\n94:               <div className=\"text-sm font-bold text-white font-mono-numbers leading-tight\">\n95:                 {activeTrader.handle}\n96:               </div>\n97:               <div className=\"text-[10px] text-slate-400 font-mono-numbers mt-0.5\">\n98:                 {activeTrader.weeklyRank} · +{activeTrader.sevenDayReturn}% 7d · copy {activeTrader.copyRatio}x\n99:               </div>\n100:             </div>\n101:           </div>\n102: \n103:           {/* Last 6 Win/Loss Pills */}\n104:           <div className=\"flex flex-col items-end\">\n105:             <div className=\"flex items-center gap-1\">\n106:               {activeTrader.lastSix.map((res: 'W' | 'L', i: number) => (\n107:                 <span\n108:                   key={i}\n109:                   className={`w-2.5 h-4 rounded-sm transition-all ${\n110:                     res === 'W'\n111:                       ? 'bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.6)]'\n112:                       : 'bg-rose-500 shadow-[0_0_8px_rgba(244,63,94,0.6)]'\n113:                   }`}\n114:                   title={res === 'W' ? 'Win' : 'Loss'}\n115:                 ></span>\n116:               ))}\n117:             </div>\n118:             <div className=\"text-[10px] text-emerald-400 font-mono-numbers mt-1.5 font-semibold\">\n119:               with him: +${activeTrader.pnlWithUs.toFixed(2)}\n120:             </div>\n121:           </div>\n122:         </div>\n123: \n124:         <div className=\"text-[10px] text-slate-500 font-mono-numbers flex justify-between\">\n125:           <span>Active Allocation</span>\n126:           <span className=\"text-blue-400 font-semibold\">25% per Trade</span>\n127:         </div>\n128:       </div>\n129: \n130:       {/* 4. FIRE RULE CARD */}\n131:       <div className=\"cyber-card p-4 rounded-2xl flex flex-col justify-between border-rose-500/20\">\n132:         <div className=\"flex items-center justify-between\">\n133:           <div className=\"text-[11px] font-mono-numbers text-slate-400 font-semibold tracking-wider uppercase flex items-center gap-1.5\">\n134:             <Flame className=\"w-3.5 h-3.5 text-rose-400\" />\n135:             Fire Rule\n136:           </div>\n137:           <span className=\"text-[10px] font-mono-numbers text-slate-400 font-semibold uppercase\">\n138:             Losses in a row\n139:           </span>\n140:         </div>\n141: \n142:         <div className=\"my-2 flex items-center justify-between\">\n143:           <div>\n144:             <div className=\"text-xl font-extrabold text-white font-mono-numbers tracking-tight\">\n145:               2 L in a row\n146:             </div>\n147:             <div className=\"text-[10px] text-slate-400 font-mono-numbers mt-0.5\">\n148:               → next trader from weekly top\n149:             </div>\n150:           </div>\n151: \n152:           {/* Losses boxes */}\n153:           <div className=\"flex flex-col items-end\">\n154:             <div className=\"flex items-center gap-1.5\">\n155:               <span\n156:                 className={`w-6 h-6 rounded-lg flex items-center justify-center font-mono-numbers text-xs font-bold border ${\n157:                   lossesInARow >= 1\n158:                     ? 'bg-rose-500/20 border-rose-500 text-rose-400 shadow-[0_0_10px_rgba(244,63,94,0.4)]'\n159:                     : 'bg-slate-900 border-slate-700 text-slate-500'\n160:                 }`}\n161:               >\n162:                 {lossesInARow >= 1 ? 'L' : '-'}\n163:               </span>\n164:               <span\n165:                 className={`w-6 h-6 rounded-lg flex items-center justify-center font-mono-numbers text-xs font-bold border ${\n166:                   lossesInARow >= 2\n167:                     ? 'bg-rose-500/20 border-rose-500 text-rose-400 shadow-[0_0_10px_rgba(244,63,94,0.4)]'\n168:                     : 'bg-slate-900 border-slate-700 text-slate-500'\n169:                 }`}\n170:               >\n171:                 {lossesInARow >= 2 ? 'L' : '-'}\n172:               </span>\n173:               <span className=\"text-xs font-mono-numbers text-slate-400 ml-1\">\n174:                 {lossesInARow}/2\n175:               </span>\n176:             </div>\n177:             <div className=\"text-[10px] text-slate-400 font-mono-numbers mt-1.5\">\n178:               fired so far: <span className=\"text-rose-400 font-bold\">{firedCount}</span>\n179:             </div>\n180:           </div>\n181:         </div>\n182: \n183:         <div className=\"flex items-center justify-between pt-1\">\n184:           <span className=\"text-[10px] text-slate-500 font-mono-numbers\">Automated Protection</span>\n185:           <button\n186:             onClick={onManualFire}\n187:             className=\"text-[10px] font-mono-numbers text-rose-400 hover:text-rose-300 bg-rose-500/10 hover:bg-rose-500/20 px-2 py-0.5 rounded border border-rose-500/20 transition-all font-semibold\"\n188:           >\n189:             Manual Fire\n190:           </button>\n191:         </div>\n192:       </div>\n193:     </div>\n194:   );\n195: };\n196: \nThe above content shows the entire, complete file contents of the requested file.\n"}
