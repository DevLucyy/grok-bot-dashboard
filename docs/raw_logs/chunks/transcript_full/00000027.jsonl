t INITIAL_EVOLUTION: EvolutionState = {\n17:   level: 1,\n18:   title: 'Novice Algorithmic Desk',\n19:   xp: 0,\n20:   nextLevelXp: 150,\n21:   winStreak: 0,\n22:   totalTrades: 0,\n23:   totalWins: 0,\n24:   adaptiveWeights: {\n25:     regimePrecision: 5.0,\n26:     falseBreakoutFilter: 6.0,\n27:     sentimentCalibration: 4.0,\n28:     dynamicSizingEdge: 5.0\n29:   },\n30:   recentEvolutions: [\n31:     {\n32:       id: 'init_evo',\n33:       timestamp: new Date().toTimeString().split(' ')[0],\n34:       text: 'Neural Evolution Core Initialized. Learning active.',\n35:       type: 'XP'\n36:     }\n37:   ]\n38: };\n39: \n40: const STORAGE_KEY = 'grok_hermes_evolution_v2';\n41: \n42: export function loadStoredEvolution(): EvolutionState {\n43:   try {\n44:     const raw = localStorage.getItem(STORAGE_KEY);\n45:     if (raw) {\n46:       return JSON.parse(raw);\n47:     }\n48:   } catch {\n49:     // fallback\n50:   }\n51:   return INITIAL_EVOLUTION;\n52: }\n53: \n54: export function saveStoredEvolution(state: EvolutionState): void {\n55:   try {\n56:     localStorage.setItem(STORAGE_KEY, JSON.stringify(state));\n57:   } catch {\n58:     // ignore\n59:   }\n60: }\n61: \n62: export function addExperience(\n63:   current: EvolutionState,\n64:   amount: number,\n65:   reason: string,\n66:   type: 'XP' | 'LEVEL_UP' | 'WEIGHT_UPDATE' = 'XP'\n67: ): EvolutionState {\n68:   const newXp = current.xp + amount;\n69:   \n70:   // Find matching level\n71:   let matchedTier = LEVEL_TIERS[0];\n72:   for (const tier of LEVEL_TIERS) {\n73:     if (newXp >= tier.minXp) {\n74:       matchedTier = tier;\n75:     }\n76:   }\n77: \n78:   const isLevelUp = matchedTier.level > current.level;\n79:   const timeStr = new Date().toTimeString().split(' ')[0];\n80: \n81:   const newEvents: EvolutionEvent[] = [\n82:     {\n83:       id: `evo_${Date.now()}_${Math.random()}`,\n84:       timestamp: timeStr,\n85:       text: isLevelUp ? `⚡ LEVEL UP! Ascended to Level ${matchedTier.level}: ${matchedTier.title}! (${matchedTier.perk})` : `+${amount} XP: ${reason}`,\n86:       type: isLevelUp ? 'LEVEL_UP' : type\n87:     },\n88:     ...current.recentEvolutions.slice(0, 15)\n89:   ];\n90: \n91:   // If leveled up, boost adaptive weights\n92:   let updatedWeights = { ...current.adaptiveWeights };\n93:   if (isLevelUp) {\n94:     updatedWeights = {\n95:       regimePrecision: Number((updatedWeights.regimePrecision + 2.5).toFixed(1)),\n96:       falseBreakoutFilter: Number((updatedWeights.falseBreakoutFilter + 3.0).toFixed(1)),\n97:       sentimentCalibration: Number((updatedWeights.sentimentCalibration + 2.0).toFixed(1)),\n98:       dynamicSizingEdge: Number((updatedWeights.dynamicSizingEdge + 2.5).toFixed(1))\n99:     };\n100:   }\n101: \n102:   const updated: EvolutionState = {\n103:     ...current,\n104:     level: matchedTier.level,\n105:     title: matchedTier.title,\n106:     xp: newXp,\n107:     nextLevelXp: matchedTier.maxXp,\n108:     adaptiveWeights: updatedWeights,\n109:     recentEvolutions: newEvents\n110:   };\n111: \n112:   saveStoredEvolution(updated);\n113:   return updated;\n114: }\n115: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
