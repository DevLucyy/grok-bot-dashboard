v className={`text-xs font-mono font-extrabold mt-1.5 ${\n            committee.lumen.isLocked ? 'text-rose-400' : 'text-emerald-400'\n          }`}>\n            {committee.lumen.isLocked ? 'LOCKED' : 'CLEAR'}\n          </div>\n          <div className=\"text-[10px] font-mono text-slate-400 mt-0.5 truncate max-w-full\">\n            {committee.lumen.minutesUntil}m to news\n          </div>\n          <div className={`mt-2 pt-1 border-t w-full text-[9px] font-mono ${\n            committee.lumen.isLocked ? 'border-rose-900/60 text-rose-400' : 'border-slate-800/80 text-amber-400/80'\n          }`}>\n            {committee.lumen.isLocked ? '🛡️ VETO HELD' : '🛡️ WATCHING'}\n          </div>\n        </div>\n\n        {/* 3. HYDRA (Multi-Timeframe Setup Grader) */}\n        <div className=\"p-3 rounded-2xl bg-gradient-to-b from-[#091b24] to-[#050e14] border border-cyan-500/30 flex flex-col items-center text-center relative group hover:border-cyan-400 transition-all shadow-lg hover:shadow-cyan-500/10\">\n          {/* Agent Avatar */}\n          <div className=\"relative my-1\">\n            <div className=\"w-14 h-14 rounded-2xl bg-gradient-to-br from-cyan-400 to-teal-600 p-0.5 shadow-md shadow-cyan-500/30 flex items-center justify-center relative overflow-hidden\">\n              <div className=\"w-full h-full bg-[#040d12] rounded-[14px] flex items-center justify-center relative\">\n                {/* Rotating Confluence Rings */}\n                <div className=\"absolute inset-1 rounded-xl border border-cyan-400/30 border-dashed animate-[spin_8s_linear_infinite]\" />\n                <CheckCircle2 className=\"w-6 h-6 text-cyan-300 animate-pulse relative z-10\" />\n                <span className=\"absolute top-1 right-1 w-2 h-2 rounded-full bg-cyan-400 animate-ping\" />\n              </div>\n            </div>\n          </div>\n          <div className=\"text-[11px] font-mono font-bold text-white mt-1\">Hydra</div>\n          <div className=\"text-[9px] font-mono text-cyan-300 uppercase tracking-wider flex items-center gap-1\">\n            <span className=\"w-1 h-1 rounded-full bg-cyan-400 animate-ping\" />\n            Confluence\n          </div>\n          <div className=\"text-xs font-mono font-extrabold text-cyan-300 mt-1.5\">\n            {committee.hydra.setupGrade} ({committee.hydra.score})\n          </div>\n          <div className=\"text-[10px] font-mono text-slate-400 mt-0.5\">&gt;70 A+ Gate</div>\n          <div className=\"mt-2 pt-1 border-t border-slate-800/80 w-full text-[9px] font-mono text-cyan-400/80\">\n            🎯 SCORING\n          </div>\n        </div>\n\n        {/* 4. SENTINEL (Risk Armor & Drawdown Lock) */}\n        <div className=\"p-3 rounded-2xl bg-gradient-to-b from-[#190e2b] to-[#0d0717] border border-purple-500/30 flex flex-col items-center text-center relative group hover:border-purple-400 transition-all shadow-lg hover:shadow-purple-500/10\">\n          {/* Agent Avatar */}\n          <div className=\"relative my-1\">\n            <div className=\"w-14 h-14 rounded-2xl bg-gradient-to-br from-purple-500 to-indigo-800 p-0.5 shadow-md shadow-purple-500/30 flex items-center justify-center relative overflow-hidden\">\n              <div className=\"w-full h-full bg-[#0b0514] rounded-[14px] flex items-center justify-center relative\">\n                {/* Pulsing Armor Shield */}\n                <div className=\"absolute inset-0 bg-purple-500/10 rounded-full animate-ping pointer-events-none\" />\n                <Lock className=\"w-6 h-6 text-purple-300 animate-pulse relative z-10\" />\n                <span className=\"absolute bottom-1 left-1 w-2 h-2 rounded-full bg-purple-400 animate-ping\" />\n              </div>\n            </div>\n          </div>\n          <div className=\"text-[11px] font-mono font-bold text-white mt-1\">Sentinel</div>\n          <div className=\"text-[9px] font-mono text-purple-300 uppercase tracking-wider flex items-center gap-1\">\n            <span className=\"w-1 h-1 rounded-full bg-purple-400 animate-ping\" />\n            Risk Armor\n          </div>\n          <div className=\"text-xs font-mono font-extrabold text-purple-300 mt-1.5\">\n            0.75% Sized\n          </div>\n          <div className=\"text-[10px] font-mono text-slate-400 mt-0.5\">\n            {committee.sentinel.consecutiveLosses}/2 Strikes\n          </div>\n          <div className=\"mt-2 pt-1 border-t border-slate-800/80 w-full text-[9px] font-mono text-purple-400/80\">\n            🔒 GUARDING\n          </div>\n        </div>\n\n        {/* 5. HEPHAESTUS (Execution & Order Forge) */}\n        <div className=\"p-3 rounded-2xl bg-gradient-to-b from-[#241308] to-[#120803] border border-orange-500/30 flex flex-col items-center text-center relative group hover:border-orange-400 transition-all shadow-lg hover:shadow-orange-500/10\">\n          {/* Agent Avatar */}\n          <div className=\"relative my-1\">\n            <div className=\"w-14 h-14 rounded-2xl bg-gradient-to-br from-amber-500 to-rose-600 p-0.5 shadow-md shadow-orange-500/30 flex items-center justify-center relative overflow-hidden\">\n              <div className=\"w-full h-full bg-[#0d0602] rounded-[14px] flex items-center justify-center relative\">\n                {/* Magma Spark Sweep */}\n                <div className=\"absolute inset-0 bg-gradient-to-t from-orange-500/20 via-transparent to-transparent animate-pulse\" />\n                <Zap className=\"w-6 h-6 text-amber-300 animate-bounce relative z-10\" />\n                <span className=\"absolute top-1 left-1 w-2 h-2 rounded-full bg-orange-400 animate-ping\" />\n              </div>\n            </div>\n          </div>\n          <div className=\"text-[11px] font-mono font-bold text-white mt-1\">Hephaestus</div>\n          <div className=\"text-[9px] font-mono text-orange-300 uppercase tracking-wider flex items-center gap-1\">\n            <span className=\"w-1 h-1 rounded-full bg-orange-400 animate-ping\" />\n        