eed={speed}\n45:         setSpeed={setSpeed}\n46:         onReset={resetSimulation}\n47:       />\n48: \n49:       {/* 2. Unified Mastermind Beast Core (Pulsing Brain, Level Progression, 7 Internal Cognitive Lobes, Neural Thought Stream) */}\n50:       <MastermindCore\n51:         evolution={evolution}\n52:         committee={committee}\n53:         currentThought={currentThought}\n54:       />\n55: \n56:       {/* 3. Top Metric Cards (Balance, P&L, Operator with Win/Loss Glow Pills, 2-Strike Handbrake) */}\n57:       <BalanceCards\n58:         balance={balance}\n59:         startingBalance={startingBalance}\n60:         totalPnl={totalPnl}\n61:         pnlPercent={pnlPercent}\n62:         pnlMultiplier={pnlMultiplier}\n63:         activeTrader={activeTrader}\n64:         lossesInARow={lossesInARow}\n65:         firedCount={firedCount}\n66:         onManualFire={() => {}}\n67:         marketCategory={marketCategory}\n68:       />\n69: \n70:       {/* 4. Middle Section: Stepped Chart & Copy Feed */}\n71:       <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-5\">\n72:         {/* Left: Balance History Stepped Chart (7 Cols) */}\n73:         <div className=\"lg:col-span-7\">\n74:           <SteppedChart\n75:             history={chartHistory}\n76:             currentBalance={balance}\n77:           />\n78:         </div>\n79: \n80:         {/* Right: Streaming Trade & Evolution Feed (5 Cols) */}\n81:         <div className=\"lg:col-span-5\">\n82:           <CopyFeed logs={logs} />\n83:         </div>\n84:       </div>\n85: \n86:       {/* 5. Bottom: Trader Bench Roster */}\n87:       <TraderBench\n88:         traders={traders}\n89:         activeTraderId={activeTraderId}\n90:         onSelectTrader={selectTrader}\n91:       />\n92: \n93:       {/* 6. Footer Disclaimer & AppSec Safety Notice */}\n94:       <footer className=\"mt-2 pt-3 border-t border-[#1a233d]/60 flex flex-col sm:flex-row items-center justify-between text-[11px] text-slate-500 font-mono gap-2\">\